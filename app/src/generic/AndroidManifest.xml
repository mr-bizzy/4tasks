<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

  <application tools:ignore="MissingApplicationIcon">
    <!-- 0.1.15: Microsoft sign-in is out of the shipped app (CalDAV only). MicrosoftAuthenticationActivity and
         MicrosoftSignInProblemActivity are no longer declared; their code stays in the tree for later
         (docs/SYNC-PLAN.md). AppAuth's own exported RedirectUriReceiverActivity (the msauth return) is removed,
         so no app or web page can open 4Tasks through it. A unit test (ShippedManifestTest) checks all three. -->
    <activity
        android:name="net.openid.appauth.RedirectUriReceiverActivity"
        tools:node="remove" />
  </application>

</manifest>
